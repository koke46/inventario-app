{
    "name":  "el-miarma",
    "version":  "1.0.3",
    "description":  "App de inventario para El Miarma",
    "author":  "El Miarma",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "build":  "electron-packager . \"El Miarma\" --platform=win32 --arch=x64 --overwrite --out=dist --ignore=dist",
                    "make":  "electron-forge make && powershell -Command \"Get-ChildItem out/make/squirrel.windows/x64/*.exe | Copy-Item -Destination 'C:/Users/jorge/Desktop/El Miarma Bar Setup.exe'\"",
                    "make-tienda":  "electron-forge make --config forge.tienda.config.js && powershell -Command \"Get-ChildItem out/make/squirrel.windows/x64/*.exe | Copy-Item -Destination 'C:/Users/jorge/Desktop/El Miarma Tienda Setup.exe'\"",
                    "make-all":  "npm run make && npm run make-tienda"
                },
    "config":  {
                   "forge":  {
                                 "packagerConfig":  {
                                                        "name":  "El Miarma",
                                                        "executableName":  "El Miarma"
                                                    },
                                 "makers":  [
                                                {
                                                    "name":  "@electron-forge/maker-squirrel",
                                                    "config":  {
                                                                   "name":  "ElMiarma"
                                                               }
                                                }
                                            ]
                             }
               },
    "devDependencies":  {
                            "@electron-forge/cli":  "^7.11.2",
                            "@electron-forge/maker-squirrel":  "^7.11.2",
                            "@electron/packager":  "^18.3.6",
                            "electron":  "^31.0.0"
                        }
}
